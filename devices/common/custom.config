## Custom Configuration

# Mesh Roaming Optimization
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_luci-app-usteer=y

# Smart Home, Wireless Printer, & Apple HomeKit Discovery
CONFIG_PACKAGE_umdns=y

## USB Core and Storage Support
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

## File System Drivers
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y

## Disk Management & Repair Utilities
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_exfatprogs=y
CONFIG_PACKAGE_luci-app-hd-idle=y

## KSMBD Kernel Samba Server & LuCI GUI
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y

## WireGuard Support & LuCI GUI
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_luci-proto-wireguard=y

## Policy-Based Routing (PBR) for Smart VPN Splitting
CONFIG_PACKAGE_pbr-nft=y
CONFIG_PACKAGE_luci-app-pbr=y

## Network Diagnostics & Traffic Monitoring
CONFIG_PACKAGE_luci-app-nlbwmon=y

## Qualcomm Hardware Crypto Accelerator Offload Engine
CONFIG_PACKAGE_kmod-crypto-qce=y
